# dual-screen: laptop + external LG DualUp
vivaldi
sleep 2   # browser first; PWAs are --app windows of the same Vivaldi instance
gtk-launch vivaldi-calendar.vimcal.com__-Default      # Vimcal
gtk-launch vivaldi-ticktick.com__webapp-Default       # TickTick
flatpak run us.zoom.Zoom
claude-desktop
gtk-launch vivaldi-mail.missiveapp.com__-Default      # Missive
flatpak run com.slack.Slack
flatpak run org.signal.Signal
flatpak run io.github.mimbrero.WhatsAppDesktop
spotify
konsole
