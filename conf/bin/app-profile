#!/usr/bin/env bash
# Launch every app in a named profile (bulk app start, on command).
#
#   app-profile work            launch ~/.config/app-profiles/work.profile
#   app-profile -n work         print what would be launched, launch nothing
#   app-profile --list          list available profiles
#
# A profile is plain text: one shell command per line, `#` starts a comment,
# and a bare `sleep <seconds>` line pauses (e.g. let the browser settle
# before its --app windows open). Desktop-agnostic: it only starts apps;
# where windows land is the window manager's job.
set -euo pipefail

dir="${APP_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/app-profiles}"
dry=0

usage() { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; }

list() {
	local f found=0
	for f in "$dir"/*.profile; do
		[[ -e $f ]] || continue
		basename "$f" .profile
		found=1
	done
	[[ $found -eq 1 ]] || echo "no profiles in $dir" >&2
}

name=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		-n|--dry-run) dry=1 ;;
		-l|--list) list; exit 0 ;;
		-h|--help) usage; exit 0 ;;
		-*) echo "unknown option: $1" >&2; exit 2 ;;
		*) name="$1" ;;
	esac
	shift
done

if [[ -z $name ]]; then usage >&2; exit 2; fi

file="$dir/$name.profile"
if [[ ! -f $file ]]; then
	echo "no such profile: $name (looked in $dir)" >&2
	echo "available:" >&2
	list >&2
	exit 1
fi

while IFS= read -r line || [[ -n $line ]]; do
	line="${line%%#*}"
	line="${line#"${line%%[![:space:]]*}"}"
	line="${line%"${line##*[![:space:]]}"}"
	[[ -n $line ]] || continue

	if [[ $line =~ ^sleep[[:space:]]+([0-9]+(\.[0-9]+)?)$ ]]; then
		if [[ $dry -eq 1 ]]; then echo "sleep ${BASH_REMATCH[1]}"; else sleep "${BASH_REMATCH[1]}"; fi
		continue
	fi

	if [[ $dry -eq 1 ]]; then
		echo "launch: $line"
	else
		echo "launching: $line"
		setsid -f sh -c "$line" >/dev/null 2>&1 </dev/null
	fi
done < "$file"
