{
  "manifest_version": 3,
  "name": "PWA Link-Out",
  "version": "1.2",
  "description": "Bounce non-app links opened in the vivaldi-apps instance over to main Vivaldi",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "nativeMessaging"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["click.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["open-patch.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
