#!/usr/bin/env python3
"""Native messaging host: open a URL in the main Vivaldi instance.

Spawned by the PWA Link-Out extension running in the vivaldi-apps
instance. Plain `vivaldi <url>` targets the default user-data-dir
(~/.config/vivaldi), i.e. the main extension-loaded browser.
"""
import json
import os
import re
import struct
import subprocess
import sys
import time

LOG = os.path.expanduser("~/.local/state/penguino-linkout.log")

def log(line):
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%F %T')} {line}\n")

log("host invoked")
raw = sys.stdin.buffer.read(4)
if len(raw) == 4:
    (length,) = struct.unpack("<I", raw)
    msg = json.loads(sys.stdin.buffer.read(length))
    url = msg.get("url", "")
    ok = bool(re.match(r"^https?://", url))
    log(f"url={url!r} ok={ok} via={msg.get('via', '?')}")
    if ok:
        subprocess.Popen(
            ["/opt/vivaldi/vivaldi", url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    out = json.dumps({"ok": ok}).encode()
    sys.stdout.buffer.write(struct.pack("<I", len(out)) + out)
    sys.stdout.buffer.flush()
