{
  "manifest_version": 3,
  "name": "PWA Router",
  "version": "1.3",
  "description": "Send Missive links into the Missive app window; fold command-line URL windows into the main window; reap dead tabs left by custom-scheme launches",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage"
  ]
}
